// 主要功能：設定 Cloudflare Worker 入口、AI 與 Vectorize 綁定、保留的 D1 綁定及部署相關選項。

{
  "name": "little-water-engineer-api",
  // Worker 入口；npm start 啟動的本機 Node.js 服務不使用這個入口。
  "main": "src/index.js",
  "compatibility_date": "2026-10-14",
  "preview_urls": false,
  "observability": { "enabled": true },
  // 命名空間隔離這批教材向量；改名後需重新同步，舊向量不會自動搬移。
  "vars": {
    "VECTOR_NAMESPACE": "water-materials-v1",
  },

  // env.AI 提供文字嵌入及聊天模型呼叫；服務密鑰另用 wrangler secret 設定。
  "ai": {
    "binding": "AI",
  },

  // 保留原部署的 D1 綁定；目前網站內容及帳號儲存在本機 SQLite，AI Worker 不讀寫 D1。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "little-water-engineer-db",
      "database_id": "aa2fe951-059f-47ad-bddf-2d851a2335ac",
    },
  ],

  // env.VECTORIZE 儲存 1024 維向量；片段全文與發布資格由本機 SQLite 管理。
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "little-water-engineer-vectors",
      "remote": true, // 指定本機開發時，是否直接使用 Cloudflare 雲端的 Vectorize。
    },
  ],
}
