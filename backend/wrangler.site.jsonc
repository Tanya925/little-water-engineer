// Cloudflare 部署設定：同一 Worker 提供公開靜態檔與 /api/*，並繫結正式 D1、
// Vectorize 及 Workers AI。assets.run_worker_first 只攔截 API，其他路徑由靜態資產
// 直接回應；不要把帳密或 API key 寫在 vars，機密應以 Wrangler secret 管理。
{
  "name": "little-water-engineer-site",
  "main": "src/site-worker.js",
  "compatibility_date": "2026-10-23",
  "observability": { "enabled": true },
  "vars": { "VECTOR_NAMESPACE": "water-materials-v1" },
  "assets": { "directory": "../frontend/public", "run_worker_first": ["/api/*"] },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "little-water-engineer-db",
      "database_id": "aa2fe951-059f-47ad-bddf-2d851a2335ac"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "little-water-engineer-vectors",
      "remote": true
    }
  ]
}
